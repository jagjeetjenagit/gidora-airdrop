<!-- Wallet picker -->
<dialog class="modal" id="wallet-modal" aria-labelledby="wallet-modal-title">
  <div class="modal-head">
    <h3 id="wallet-modal-title">Connect a Solana wallet</h3>
    <button class="icon-btn" data-close aria-label="Close"><svg class="i"><use href="#i-x"/></svg></button>
  </div>
  <p class="muted small">Connecting only shares your public address. It does not move funds or approve any transfer.</p>
  <div class="wallet-list" id="wallet-list"></div>
  <p class="muted xsmall mt-2"><svg class="i i-inline"><use href="#i-shield"/></svg> You'll be asked to sign a free message to prove you own the wallet. No transaction, no fee.</p>
</dialog>

<!-- Generic modal (claim confirmation etc.) -->
<dialog class="modal" id="app-modal" aria-labelledby="app-modal-title"></dialog>

<div class="toasts" id="toasts" aria-live="polite" aria-atomic="false"></div>

<% if (isStatic) { %><script src="<%= base %>js/static-config.js"></script>
<script src="<%= base %>js/static-api.js"></script>
<% } %><script src="<%= base %>js/app.js"></script>
