<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= site.brand.name %> (<%= site.brand.ticker %>)</title>
  <meta name="description" content="<%= site.brand.tagline %> Eligible Solana wallets can claim GDR from the 10,000,000 GDR early-adoption allocation.">
  <meta name="theme-color" content="#0b0e11">
  <meta property="og:title" content="<%= title %> · GIDORA">
  <meta property="og:description" content="<%= site.brand.tagline %>">
  <link rel="icon" href="<%= base %>img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= base %>css/styles.css">
</head>
<body data-page="<%= nav %>" data-demo="<%= site.demo %>" data-base="<%= base %>" data-static="<%= isStatic %>">
<%- include('icons') %>
<div class="preloader" id="preloader" aria-hidden="true">
  <div class="pl-inner">
    <div class="pl-mark">
      <svg class="pl-ring" viewBox="0 0 120 120"><circle cx="60" cy="60" r="54" class="pl-track"/><circle cx="60" cy="60" r="54" class="pl-arc"/></svg>
      <img src="<%= base %>img/logo-mark.svg" alt="" width="64" height="64">
    </div>
    <img class="pl-word" src="<%= base %>img/logo-word.svg" alt="GIDORA" width="168" height="32">
    <div class="pl-bar"><span></span></div>
    <div class="pl-tag"><%= site.brand.tagline %></div>
  </div>
</div>
<a class="skip-link" href="#main">Skip to content</a>

<% if (site.demo) { %>
<div class="demo-bar" role="note">
  <span class="tag">DEMO</span>
  <span>MVP preview: wallets, claims and figures are simulated. No on-chain transactions are made.</span>
</div>
<% } %>

<header class="site-header" id="top">
  <div class="container header-inner">
    <a href="<%= base %>" class="logo" aria-label="GIDORA home">
      <img class="logo-full" src="<%= base %>img/logo.svg" alt="GIDORA" width="134" height="35">
    </a>

    <nav class="main-nav" id="main-nav" aria-label="Primary">
      <a href="<%= base %>" class="<%= nav === 'claim' ? 'active' : '' %>" <%- nav === 'claim' ? 'aria-current="page"' : '' %>>Claim Airdrop</a>
      <a href="<%= base %>leaderboard/" class="<%= nav === 'leaderboard' ? 'active' : '' %>" <%- nav === 'leaderboard' ? 'aria-current="page"' : '' %>>Leaderboard</a>
      <a href="<%= base %>rewards/" class="<%= nav === 'rewards' ? 'active' : '' %>" <%- nav === 'rewards' ? 'aria-current="page"' : '' %>>Rewards</a>
      <a href="<%= base %>#how-it-works">How It Works</a>
      <a href="<%= base %>#faq">FAQ</a>
    </nav>

    <div class="header-actions">
      <span class="net-pill" title="Network"><span class="dot" aria-hidden="true"></span><svg class="i" aria-hidden="true"><use href="#i-solana"/></svg>Solana</span>
      <a href="<%= base %>#claim" class="btn btn-ghost btn-sm mobile-claim">Claim</a>
      <div class="wallet-slot" data-wallet-slot>
        <button class="btn btn-primary btn-sm" data-action="connect">
          <svg class="i" aria-hidden="true"><use href="#i-wallet"/></svg>
          <span>Connect Wallet</span>
        </button>
      </div>
      <button class="icon-btn menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="main-nav" data-action="menu">
        <svg class="i" aria-hidden="true"><use href="#i-menu"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="ticker" aria-label="Recent claims" id="ticker">
  <span class="ticker-label"><span class="live" aria-hidden="true"></span>Live claims</span>
  <div class="ticker-track" id="ticker-track" aria-live="off"></div>
</div>

<main id="main">
